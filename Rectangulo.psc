Algoritmo  Rectangulo
	Definir ladoA, ladoB Como Real
	Definir perimetro, area Como Real
	
	Escribir "ingrese la longitud del primer lado:"
	Leer ladoA
	
	Escribir "ingrese la longitud del segundo lado:"
	Leer ladoB
	
	perimetro <- 2 * (ladoA * ladoB) 
	area <- ladoA * ladoB 
	
	Escribir "el perimetro del rectangulo es: ", perimetro
	Escribir "el area del rectangulo es: ", area 
	
	
	
	
	
	
	
FinAlgoritmo
