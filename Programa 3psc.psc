Algoritmo prueba03
	
	Definir num1, num2, num3, num4 Como Real
	Definir suma, promedio Como Real
	
	Escribir "Por favor, ingrese el primer número: "
	Leer num1
	Escribir "Por favor, ingrese el segundo número: "
	Leer num2
	Escribir "Por favor, ingrese el tercer número: "
	Leer num3
	Escribir "Por favor, ingrese el cuarto número: "
	Leer num4
	
	
	suma <- num1 + num2 + num3 + num4
	promedio <- suma / 4
	
	Escribir "La suma total de los números es: ", suma
	Escribir "El promedio de los números es: ", promedio

	
FinAlgoritmo
