Algoritmo OperacionesMatematicas
	Definir numero1, numero2 Como Entero
	
	Escribir "ingrese el primer numero entero:";
	Leer numero1
	
	Escribir "ingrese el segundo numero entero.";
	Leer numero2
	
	Escribir "suma: ", numero1 + numero2
	Escribir "resta: ", numero1 - numero2
	Escribir "multiplicacion: ", numero1 * numero2
	
	si numero2 <> 0 Entonces
		Escribir "divicion: ", numero1 / numero2
		Escribir "modulo: ", numero1 mod numero2 
	SiNo
		Escribir "no se puede dividir entre cero"
		
		
		
		
		
		
	FinSi
	
	
FinAlgoritmo
