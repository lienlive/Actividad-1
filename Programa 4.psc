Algoritmo prueba04
	
	Definir precio, totalPagar Como Real
	Definir cantidad Como Entero
	
	
	Escribir "Ingrese el precio del artículo:"
	Leer precio
	Escribir "Ingrese la cantidad de artículos que lleva el cliente:"
	Leer cantidad
	
	
	totalPagar <- precio * cantidad
	
	
	Escribir "Resumen de la compra:"
	Escribir "Cantidad de artículos: ", cantidad
	Escribir "Precio unitario: $ ", precio
	Escribir "Total neto a pagar: $ ", totalPagar
	
	
FinAlgoritmo
